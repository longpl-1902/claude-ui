expect {"type":"control_request","body":{"type":"initialize"}}
reply {}
expect {"type":"user"}
emit {"type":"control_request","subtype":"can_use_tool","request_id":"r1","tool":{"toolName":"Bash","input":{"command":"ls"}}}
expect {"type":"control_response","request_id":"r1","body":{"behavior":"deny","message":"Stopped by user"}}
