expect {"type":"control_request","request":{"subtype":"initialize"}}
reply {}
expect {"type":"user"}
emit {"type":"control_request","request_id":"r1","request":{"subtype":"can_use_tool","tool_name":"Bash","input":{"command":"ls"}}}
