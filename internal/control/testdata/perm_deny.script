expect {"type":"control_request","request":{"subtype":"initialize"}}
reply {}
expect {"type":"user"}
emit {"type":"system","subtype":"init","session_id":"{{session}}"}
expect {"type":"control_request","request":{"subtype":"mcp_status"}}
reply {}
emit {"type":"control_request","request_id":"d1","request":{"subtype":"can_use_tool","tool_name":"Write","input":{"file_path":"C:/Users/u/a.txt"}}}
expect {"type":"control_response","response":{"subtype":"success","request_id":"d1","response":{"behavior":"deny","message":"Denied by user"}}}
emit {"type":"control_request","request_id":"d2","request":{"subtype":"can_use_tool","tool_name":"Write","input":{"file_path":"C:/Users/u/b.txt"}}}
expect {"type":"control_response","response":{"subtype":"success","request_id":"d2","response":{"behavior":"deny","message":"not now"}}}
emit {"type":"control_request","request_id":"d3","request":{"subtype":"can_use_tool","tool_name":"ExitPlanMode","input":{"plan":"step 1"}}}
expect {"type":"control_response","response":{"subtype":"success","request_id":"d3","response":{"behavior":"deny","message":"User rejected the plan"}}}
emit {"type":"control_request","request_id":"d4","request":{"subtype":"can_use_tool","tool_name":"ExitPlanMode","input":{"plan":"step 2"}}}
expect {"type":"control_response","response":{"subtype":"success","request_id":"d4","response":{"behavior":"allow","updatedInput":{"plan":"step 2"}}}}
exit 0
