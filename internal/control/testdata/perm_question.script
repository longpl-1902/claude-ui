expect {"type":"control_request","body":{"type":"initialize"}}
reply {}
expect {"type":"user"}
emit {"type":"system","subtype":"init","message":{"sessionId":"{{session}}"}}
expect {"type":"control_request","body":{"type":"mcp_status"}}
reply {}
emit {"type":"control_request","subtype":"can_use_tool","request_id":"q1","tool":{"toolName":"AskUserQuestion","input":{"questions":[{"question":"Which?","header":"Pick","options":[{"label":"A","description":"first"},{"label":"B"}],"multiSelect":false}]}}}
expect {"type":"control_response","request_id":"q1","body":{"behavior":"allow","updatedInput":{"answers":{"Which?":"A"},"questions":[{"question":"Which?"}]}}}
exit 0
