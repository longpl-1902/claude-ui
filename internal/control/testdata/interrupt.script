expect {"type":"control_request","request":{"subtype":"initialize"}}
reply {}
expect {"type":"user"}
emit {"type":"control_request","request_id":"r1","request":{"subtype":"can_use_tool","tool_name":"Bash","input":{"command":"sleep 100"}}}
expect {"type":"control_response","response":{"subtype":"success","request_id":"r1","response":{"behavior":"deny","message":"Interrupted by user"}}}
expect {"type":"control_request","request":{"subtype":"interrupt"}}
emit {"type":"result","stop_reason":"interrupted"}
exit 0
