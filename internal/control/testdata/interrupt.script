expect {"type":"control_request","body":{"type":"initialize"}}
reply {}
expect {"type":"user"}
emit {"type":"control_request","subtype":"can_use_tool","request_id":"r1","tool":{"toolName":"Bash","input":{"command":"sleep 100"}}}
expect {"type":"control_response","request_id":"r1","body":{"behavior":"deny","message":"Interrupted by user"}}
expect {"type":"control_request","body":{"type":"interrupt"}}
emit {"type":"result","stop_reason":"interrupted"}
exit 0
