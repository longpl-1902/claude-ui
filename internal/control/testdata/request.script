expect {"type":"control_request","request":{"subtype":"initialize"}}
reply {}
expect {"type":"user"}
emit {"type":"system","subtype":"init","session_id":"{{session}}"}
expect {"type":"control_request","request":{"subtype":"mcp_status"}}
reply {"servers":[]}
expect {"type":"control_request","request":{"subtype":"rename_session","title":"x"}}
reply {"ok":true}
expect {"type":"control_request","request":{"subtype":"set_model","model":"sonnet"}}
reply {}
expect {"type":"control_request","request":{"subtype":"get_context_usage"}}
wait-eof
