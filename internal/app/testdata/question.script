# AskUserQuestion answered with a picked label.
expect {"type":"control_request","request":{"subtype":"initialize"}}
reply {}
expect {"type":"user"}
emit {"type":"system","subtype":"init","session_id":"{{session}}"}
expect {"type":"control_request","request":{"subtype":"mcp_status"}}
reply {}
emit {"type":"control_request","request_id":"q1","request":{"subtype":"can_use_tool","tool_name":"AskUserQuestion","input":{"questions":[{"question":"Which?","header":"Pick","options":[{"label":"A","description":"first"},{"label":"B"}],"multiSelect":false}]}}}
expect {"type":"control_response","response":{"subtype":"success","request_id":"q1","response":{"behavior":"allow","updatedInput":{"answers":{"Which?":"A"}}}}}
emit {"type":"result","stop_reason":"end_turn"}
