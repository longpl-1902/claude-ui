# One Bash permission, allowed once.
expect {"type":"control_request","body":{"type":"initialize"}}
reply {}
expect {"type":"user"}
emit {"type":"system","subtype":"init","message":{"sessionId":"{{session}}","model":"claude-test"}}
expect {"type":"control_request","body":{"type":"mcp_status"}}
reply {}
emit {"type":"control_request","subtype":"can_use_tool","request_id":"r1","tool":{"toolName":"Bash","displayName":"Bash","input":{"command":"ls"},"description":"list files"},"suggestions":[{"type":"addRules","behavior":"allow","destination":"localSettings","rules":[{"toolName":"Bash"}]}],"can_allow_session":true}
expect {"type":"control_response","request_id":"r1","body":{"behavior":"allow","updatedInput":{"command":"ls"}}}
emit {"type":"result","stop_reason":"end_turn"}
