# A forked turn: the child announces the fork id.
expect {"type":"control_request","body":{"type":"initialize"}}
reply {}
expect {"type":"user"}
emit {"type":"system","subtype":"init","message":{"sessionId":"{{fork}}","model":"claude-test"}}
expect {"type":"control_request","body":{"type":"mcp_status"}}
reply {}
emit {"type":"result","stop_reason":"end_turn"}
